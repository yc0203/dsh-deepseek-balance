{
  "name": "dsh-deepseek-balance",
  "version": "1.0.0",
  "description": "DeepSeek Harness 侧栏余额插件：在左下角设置按钮上方实时显示 DeepSeek API 余额，每 5 秒自动刷新，并带手动刷新按钮。DeepSeek balance widget for DSH: shows your DeepSeek API balance right above the Settings button, auto-refreshing every 5 seconds with a manual refresh button.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "deepseek",
    "balance",
    "余额"
  ],
  "author": {
    "name": "yc0203"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^18.2.0"
  }
}
